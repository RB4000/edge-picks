<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily 7:00 AM run. launchd uses the Mac's local time zone, so this is 7am CT only if
  System Settings > General > Date & Time is set to Central. Otherwise change Hour.
  If the Mac is asleep at 7:00, launchd runs the job when it wakes.

  Install:
    cp ops/com.nfledge.update.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nfledge.update.plist
  Run now (test):   launchctl kickstart gui/$(id -u)/com.nfledge.update
  Uninstall:        launchctl bootout gui/$(id -u)/com.nfledge.update
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nfledge.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/rb/projects/nfl-edge &amp;&amp; AUTO_DEPLOY=1 LEDGER_AUTOCOMMIT=1 ./update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/rb/projects/nfl-edge/data/logs/update.log</string>
  <key>StandardErrorPath</key><string>/Users/rb/projects/nfl-edge/data/logs/update.log</string>
</dict>
</plist>
